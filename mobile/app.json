{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "scheme": "musicroom",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#121212",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Music Room needs your location to check you're allowed to vote in a location-restricted event."
      }
    },
    "android": {
      "package": "com.musicroomandroid.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-audio",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Music Room needs your location to check you're allowed to vote in a location-restricted event."
        }
      ],
      "expo-web-browser"
    ]
  }
}
