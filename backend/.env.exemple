# Server
PORT=3000

# Database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/musicroom

# Redis
REDIS_URL=redis://127.0.0.1:6380

# JWT
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d

# Firebase
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_client_email
FIREBASE_PRIVATE_KEY=your_private_key

# Mail: 'ethereal' uses a throwaway/fixed test inbox (see MailService), no
# real delivery, just a preview link logged on every send. Set a real SMTP
# provider below instead (Brevo, etc.) to actually deliver mail.
MAIL_HOST=ethereal
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USER=replace_with_your_smtp_username
# MAIL_PASSWORD=replace_with_your_smtp_password
# Must be a sender verified with your SMTP provider, otherwise mails are
# silently dropped by the recipient (no SPF/DKIM = spam filters eat it)
# MAIL_FROM=replace_with_a_verified_sender_email

# Google OAuth
GOOGLE_CLIENT_ID_WEB=your_google_web_client_id
GOOGLE_CLIENT_SECRET_WEB=your_google_web_client_secret
GOOGLE_CALLBACK_URL_WEB=http://localhost:3000/auth/google/web/callback
GOOGLE_CLIENT_ID_ANDROID=your_google_android_client_id
GOOGLE_CLIENT_ID_IOS=your_google_ios_client_id

# Rate limiting (sujet V.6) - plafond global par IP sur les routes HTTP.
# Les routes d'authentification ont leur propre limite, bien plus serree, non
# configurable ici (voir src/auth/auth-throttle.ts).
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=300
# IP exemptees de tout plafond, separees par des virgules. A ne remplir QUE le
# temps d'un test de charge (cf. docs/ramp-up.md), jamais en production.
THROTTLE_ALLOWLIST=

# App
APP_URL=http://localhost:3000

# adresses ou le backend a le droit de renvoyer l'app apres google, separees
# par des virgules. une url http(s) autorise son origine, un schema seul
# (musicroom://) autorise tout ce schema. pas a declarer chez google : seule
# /auth/google/web/callback l'est
#   http://localhost:8082  expo web (a adapter si expo tourne sur un autre port)
#   musicroom://           build natif (scheme de mobile/app.json)
#   exp://                 expo go, en dev seulement : n'importe quel projet expo
#                          go pourrait recevoir le code
# sur l'emulateur android, google renvoie sur localhost:3000 : make
# android-reverse (lance par make start et make dev-mobile) le renvoie au backend
OAUTH_APP_REDIRECT=http://localhost:8082,musicroom://,exp://
